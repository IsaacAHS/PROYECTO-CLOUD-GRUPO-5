# NimbusCore - Linux cluster phase 2
#
# Archivo opcional. Copialo como `.env` solo si quieres sobreescribir los
# defaults de `docker-compose.yml`:
#
#   cp deploy/env/linux-phase2.env.example .env
#
# Docker Compose lee `.env` automaticamente si existe.

# App actua como headnode Linux en fase 2.
# Debe ser una direccion a la que el contenedor linux-driver pueda hacer SSH.
NIMBUSCORE_HEADNODE_IP=10.0.10.5

# IPs internas/ruteables de los 4 workers Linux vistas desde App.
NIMBUSCORE_COMPUTE_IPS=10.0.10.1,10.0.10.2,10.0.10.3,10.0.10.4

# Red/OVS del cluster Linux. Ajusta ens4 si la troncal L2 en la nueva instancia usa otra interfaz.
NIMBUSCORE_OVS_UPLINKS=ens4

# Mantener el directorio SSH de ubuntu montado en el linux-driver.
NIMBUSCORE_SSH_DIR=/home/ubuntu/.ssh

# Pares de llaves que se inyectan a VMs.
NIMBUSCORE_KEYPAIR_DIR=/home/ubuntu/nimbuscore-keys

# Red de gestion de VMs. Ajustar solo si la VLAN/red de acceso cambia en fase 2.
NIMBUSCORE_ENABLE_MGMT_NETWORK=true
NIMBUSCORE_MGMT_VLAN=99
NIMBUSCORE_MGMT_CIDR=10.60.9.0/24
NIMBUSCORE_MGMT_GATEWAY=10.60.9.1
NIMBUSCORE_MGMT_DNS=8.8.8.8
NIMBUSCORE_MGMT_DHCP_SERVER_IP=10.60.9.2
NIMBUSCORE_MGMT_DHCP_START=10.60.9.20
NIMBUSCORE_MGMT_DHCP_END=10.60.9.250
NIMBUSCORE_MGMT_DHCP_LEASE_TIME=12h

# Bloques usados para evitar choques entre slices.
NIMBUSCORE_VLAN_BASE=100
NIMBUSCORE_VLAN_BLOCK_SIZE=100
NIMBUSCORE_VNC_BASE=5901
NIMBUSCORE_VNC_BLOCK_SIZE=100
NIMBUSCORE_CIDR_BASE=10
NIMBUSCORE_CIDR_BLOCK_SIZE=20
